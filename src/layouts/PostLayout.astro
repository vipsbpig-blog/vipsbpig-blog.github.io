---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Twikoo from '../components/Twikoo.astro';
import Tags from '../components/Tags.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, date, tags, summary, cover } = post.data;

const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length > 0;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout wide title={title} description={summary} image={cover}>
  <div class="md:flex md:items-start md:gap-12">
    {
      hasToc && (
        <aside class="hidden md:block md:w-56 md:shrink-0 md:sticky md:top-20 md:self-start">
          <details id="toc-details" class="group">
            <summary class="flex items-center gap-2 font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
              <span class="toc-chevron inline-block transition-transform duration-200">
                ▸
              </span>
              目录
            </summary>
            <div class="mt-4">
              <TableOfContents headings={headings} />
            </div>
          </details>
        </aside>
      )
    }

    <article class="md:flex-1 md:min-w-0">
      <div class="max-w-[680px]">
        <header class="mb-12">
          <h1
            class="font-serif text-4xl font-semibold leading-[1.15] tracking-tight text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]"
          >
            {title}
          </h1>
          <div
            class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]"
          >
            <time datetime={date.toISOString()}>{dateStr}</time>
            {
              tags.length > 0 && (
                <>
                  <span class="opacity-40">·</span>
                  <Tags tags={tags} />
                </>
              )
            }
          </div>
          {
            cover && (
              <img
                src={cover}
                alt={title}
                class="mt-10 aspect-[16/9] w-full rounded-lg object-cover shadow-[var(--shadow-soft)]"
              />
            )
          }
        </header>

        {
          hasToc && (
            <details class="mb-8 border-l-2 border-[var(--color-accent)] pl-4 md:hidden">
              <summary class="font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
                目录
              </summary>
              <div class="mt-3">
                <TableOfContents headings={headings} />
              </div>
            </details>
          )
        }

        <Prose>
          <slot />
        </Prose>

        <Twikoo />
      </div>
    </article>
  </div>

  <script>
    const details = document.getElementById('toc-details');
    // 桌面端默认展开目录
    if (details && window.matchMedia('(min-width: 768px)').matches) {
      details.open = true;
    }
    // 滚动时高亮当前章节
    const headingEls = document.querySelectorAll(
      'article h2[id], article h3[id]'
    );
    const links = document.querySelectorAll('#toc-details a.toc-link');
    if (headingEls.length && links.length) {
      const map = new Map<string, Element>();
      links.forEach((l) => {
        const href = l.getAttribute('href');
        if (href) map.set(href, l);
      });
      let active: Element | null = null;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const link = map.get('#' + entry.target.id);
              if (link) {
                if (active && active !== link)
                  active.classList.remove('toc-active');
                link.classList.add('toc-active');
                active = link;
              }
            }
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headingEls.forEach((h) => observer.observe(h));
    }
  </script>
</BaseLayout>
