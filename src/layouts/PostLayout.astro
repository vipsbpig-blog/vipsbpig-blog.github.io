---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Twikoo from '../components/Twikoo.astro';
import Tags from '../components/Tags.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, date, tags, summary, cover } = post.data;

const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length > 0;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout wider title={title} description={summary} image={cover}>
  <div class="xl:grid xl:grid-cols-[1fr_minmax(0,680px)_1fr] xl:gap-8">
    <div class="hidden xl:block"></div>

    <article class="xl:min-w-0">
      <div class="mx-auto max-w-[680px]">
        <header class="mb-12">
          <h1
            class="font-serif text-4xl font-semibold leading-[1.15] tracking-tight text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]"
          >
            {title}
          </h1>
          <div
            class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]"
          >
            <time datetime={date.toISOString()}>{dateStr}</time>
            <span class="opacity-40">·</span>
            <span class="inline-flex items-center gap-1">
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                ></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span id="twikoo_visitors">0</span>
            </span>
            {
              tags.length > 0 && (
                <>
                  <span class="opacity-40">·</span>
                  <Tags tags={tags} />
                </>
              )
            }
          </div>
          {
            cover && (
              <img
                src={cover}
                alt={title}
                class="mt-10 aspect-[16/9] w-full rounded-lg object-cover shadow-[var(--shadow-soft)]"
              />
            )
          }
        </header>

        {
          hasToc && (
            <details class="mb-8 border-l-2 border-[var(--color-accent)] pl-4 xl:hidden">
              <summary class="font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
                目录
              </summary>
              <div class="mt-3">
                <TableOfContents headings={headings} />
              </div>
            </details>
          )
        }

        <Prose>
          <slot />
        </Prose>

        <Twikoo />
      </div>
    </article>

    {
      hasToc && (
        <aside class="hidden xl:block xl:sticky xl:top-20 xl:self-start xl:justify-self-start xl:w-56">
          <details id="toc-details" class="group" open>
            <summary class="flex items-center gap-2 font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
              <span class="toc-chevron inline-block transition-transform duration-200">
                ▸
              </span>
              目录
            </summary>
            <div class="mt-4">
              <TableOfContents headings={headings} />
            </div>
          </details>
          {
            tags.length > 0 && (
              <div class="mt-8">
                <Tags tags={tags} />
              </div>
            )
          }
        </aside>
      )
    }
  </div>

  <script is:inline>
    // 滚动时高亮当前章节对应的 TOC 项（桌面飘浮栏 + 移动内联栏都生效）
    // is:inline：随 HTML 同步执行，文章一出现 TOC 高亮即就位，无 deferred module 延迟
    const headingEls = Array.from(
      document.querySelectorAll('article h2[id], article h3[id]')
    );
    const linksByHref = new Map();
    document.querySelectorAll('a.toc-link[href]').forEach((l) => {
      const href = l.getAttribute('href');
      if (!href) return;
      const arr = linksByHref.get(href);
      if (arr) arr.push(l);
      else linksByHref.set(href, [l]);
    });

    if (headingEls.length && linksByHref.size) {
      const visible = new Set();
      const HEADER_OFFSET = 80;

      const setActive = () => {
        // 优先：阅读带内最上方的标题
        let current = null;
        let topY = Infinity;
        visible.forEach((h) => {
          const y = h.getBoundingClientRect().top;
          if (y < topY) {
            topY = y;
            current = h;
          }
        });
        // 回退：阅读带内无标题时，取最后一个已滚过顶部的标题（仍在该章节内）
        if (!current) {
          for (const h of headingEls) {
            if (h.getBoundingClientRect().top < HEADER_OFFSET) current = h;
          }
        }
        document
          .querySelectorAll('a.toc-link.toc-active')
          .forEach((l) => l.classList.remove('toc-active'));
        if (current) {
          const links = linksByHref.get('#' + current.id);
          if (links) links.forEach((l) => l.classList.add('toc-active'));
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          setActive();
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headingEls.forEach((h) => observer.observe(h));
      setActive();
    }
  </script>
</BaseLayout>
