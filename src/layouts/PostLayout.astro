---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Twikoo from '../components/Twikoo.astro';
import Tags from '../components/Tags.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, date, tags, summary, cover } = post.data;

const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length > 0;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout wider title={title} description={summary} image={cover}>
  <div class="xl:grid xl:grid-cols-[1fr_minmax(0,680px)_1fr] xl:gap-8">
    <div class="hidden xl:block"></div>

    <article class="xl:min-w-0">
      <div class="mx-auto max-w-[680px]">
        <header class="mb-12">
          <h1
            class="font-serif text-4xl font-semibold leading-[1.15] tracking-tight text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]"
          >
            {title}
          </h1>
          <div
            class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]"
          >
            <time datetime={date.toISOString()}>{dateStr}</time>
            <span class="opacity-40">·</span>
            <span class="inline-flex items-center gap-1">
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                ></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span id="twikoo_visitors">0</span>
            </span>
            {
              tags.length > 0 && (
                <>
                  <span class="opacity-40">·</span>
                  <Tags tags={tags} />
                </>
              )
            }
          </div>
          {
            cover && (
              <img
                src={cover}
                alt={title}
                class="mt-10 aspect-[16/9] w-full rounded-lg object-cover shadow-[var(--shadow-soft)]"
              />
            )
          }
        </header>

        <Prose>
          <slot />
        </Prose>

        <Twikoo />
      </div>
    </article>

    {
      hasToc && (
        <aside class="hidden xl:block xl:sticky xl:top-20 xl:self-start xl:justify-self-start xl:w-56">
          <details id="toc-details" class="group" open>
            <summary class="flex items-center gap-2 font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
              <span class="toc-chevron inline-block transition-transform duration-200">
                ▸
              </span>
              目录
            </summary>
            <div class="mt-4">
              <TableOfContents headings={headings} />
            </div>
          </details>
          {
            tags.length > 0 && (
              <div class="mt-8">
                <Tags tags={tags} />
              </div>
            )
          }
        </aside>
      )
    }
  </div>

  {
    hasToc && (
      <button
        type="button"
        id="toc-open"
        aria-label="打开目录"
        class="fixed top-20 right-4 z-40 inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-line)] bg-[var(--color-paper)]/85 text-[var(--color-ink-mute)] opacity-80 shadow-[var(--shadow-soft)] backdrop-blur-md transition-opacity hover:opacity-100 hover:text-[var(--color-accent)] xl:hidden dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)]/85 dark:text-[var(--color-ink-mute-dark)]"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    )
  }

  {
    hasToc && (
      <dialog
        id="toc-drawer"
        class="m-0 ml-auto h-[100dvh] w-72 max-w-[85vw] rounded-l-lg border-l border-[var(--color-line)] bg-[var(--color-paper)] p-0 backdrop:bg-black/40 dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)]"
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-4 dark:border-[var(--color-line-dark)]">
            <span class="font-serif text-sm text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">目录</span>
            <button
              type="button"
              id="toc-close"
              aria-label="关闭目录"
              class="text-[var(--color-ink-mute)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              >
                <path d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </button>
          </div>
          <div class="overflow-y-auto px-5 py-4">
            <TableOfContents headings={headings} />
            {
              tags.length > 0 && (
                <div class="mt-8 border-t border-[var(--color-line)] pt-6 dark:border-[var(--color-line-dark)]">
                  <div class="mb-3 font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
                    标签
                  </div>
                  <Tags tags={tags} />
                </div>
              )
            }
          </div>
        </div>
      </dialog>
    )
  }

  <script is:inline>
    // 移动端 TOC 抽屉
    (function () {
      const btn = document.getElementById('toc-open');
      const dlg = document.getElementById('toc-drawer');
      const closeBtn = document.getElementById('toc-close');
      if (!btn || !dlg) return;
      btn.addEventListener('click', () => dlg.showModal());
      closeBtn?.addEventListener('click', () => dlg.close());
      dlg.querySelectorAll('a.toc-link').forEach((a) => {
        a.addEventListener('click', () => dlg.close());
      });
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
    })();
  </script>

  <script is:inline>
    // 滚动时高亮当前章节对应的 TOC 项（桌面飘浮栏 + 移动抽屉都生效）
    // is:inline：随 HTML 同步执行，文章一出现 TOC 高亮即就位，无 deferred module 延迟
    const headingEls = Array.from(
      document.querySelectorAll('article h2[id], article h3[id]')
    );
    const linksByHref = new Map();
    document.querySelectorAll('a.toc-link[href]').forEach((l) => {
      const href = l.getAttribute('href');
      if (!href) return;
      const arr = linksByHref.get(href);
      if (arr) arr.push(l);
      else linksByHref.set(href, [l]);
    });

    if (headingEls.length && linksByHref.size) {
      const visible = new Set();
      const HEADER_OFFSET = 80;

      const setActive = () => {
        // 优先：阅读带内最上方的标题
        let current = null;
        let topY = Infinity;
        visible.forEach((h) => {
          const y = h.getBoundingClientRect().top;
          if (y < topY) {
            topY = y;
            current = h;
          }
        });
        // 回退：阅读带内无标题时，取最后一个已滚过顶部的标题（仍在该章节内）
        if (!current) {
          for (const h of headingEls) {
            if (h.getBoundingClientRect().top < HEADER_OFFSET) current = h;
          }
        }
        document
          .querySelectorAll('a.toc-link.toc-active')
          .forEach((l) => l.classList.remove('toc-active'));
        if (current) {
          const links = linksByHref.get('#' + current.id);
          if (links) links.forEach((l) => l.classList.add('toc-active'));
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          setActive();
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headingEls.forEach((h) => observer.observe(h));
      setActive();
    }
  </script>

  <button
    type="button"
    id="back-to-top"
    aria-label="回到顶部"
    class="fixed bottom-6 right-4 z-40 lg:right-auto lg:left-[calc(50%_+_340px_+_1rem)] inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-line)] bg-[var(--color-paper)]/85 text-[var(--color-ink-mute)] opacity-0 shadow-[var(--shadow-soft)] backdrop-blur-md transition-opacity duration-200 hover:text-[var(--color-accent)] dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)]/85 dark:text-[var(--color-ink-mute-dark)]"
    style="pointer-events: none;"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
  </button>

  <script is:inline>
    // 回到顶部：离开顶部时显示，点击平滑滚回
    (function () {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      const onScroll = () => {
        const show = window.scrollY > 300;
        btn.style.opacity = show ? '1' : '0';
        btn.style.pointerEvents = show ? 'auto' : 'none';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</BaseLayout>
