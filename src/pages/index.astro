---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import {
  AUTHOR,
  AUTHOR_TAGLINE,
  AUTHOR_BIO,
  AUTHOR_AVATAR,
  SOCIAL_LINKS,
} from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).map(
  (p) => ({ type: 'dev' as const, id: p.id, ...p.data })
);
const photos = (await getCollection('photos', ({ data }) => !data.draft)).map(
  (p) => ({ type: 'photo' as const, id: p.id, ...p.data })
);

const feed = [...posts, ...photos].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

const hrefOf = (item: { type: 'dev' | 'photo'; id: string }) =>
  item.type === 'dev' ? `/posts/${item.id}/` : `/photos/${item.id}/`;
---

<BaseLayout wide>
  <div class="flex flex-col gap-12 md:flex-row md:gap-12">
    <!-- 右侧：Hero 自我介绍边栏（桌面端 sticky） -->
    <aside
      class="md:order-2 md:w-72 md:shrink-0 md:self-start md:sticky md:top-20"
    >
      <div
        class="flex flex-col items-center text-center md:items-start md:text-left"
      >
        <img
          src={AUTHOR_AVATAR}
          alt={AUTHOR}
          class="aspect-[4/5] w-28 rounded-lg object-cover shadow-[var(--shadow-soft)]"
        />
        <h1
          class="mt-4 font-serif text-xl font-semibold tracking-tight text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]"
        >
          {AUTHOR}
        </h1>
        <p
          class="mt-1 font-serif text-sm italic text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)]"
        >
          {AUTHOR_TAGLINE}
        </p>
      </div>

      <p
        class="mt-4 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)]"
      >
        {AUTHOR_BIO}
      </p>

      <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener"
          class="text-[var(--color-ink-mute)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]">GitHub</a
        >
        <a
          href={SOCIAL_LINKS.rss}
          class="text-[var(--color-ink-mute)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]">RSS</a
        >
        <a
          href="/about"
          class="text-[var(--color-ink-mute)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]">关于 →</a
        >
      </div>
    </aside>

    <!-- 左侧：时间线（大边幅） -->
    <div class="md:order-1 md:min-w-0 md:flex-1">
      <div class="mb-6 flex items-center gap-4">
        <h2
          class="font-serif text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]"
        >
          时间线
        </h2>
        <div
          class="h-px flex-1 bg-[var(--color-line)] dark:bg-[var(--color-line-dark)]"
        >
        </div>
      </div>

      <div>
        {
          feed.map((item) => (
            <PostCard
              type={item.type}
              title={item.title}
              date={item.date}
              summary={item.summary}
              tags={item.tags}
              cover={item.cover}
              href={hrefOf(item)}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
