---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).map(
  (p) => ({ type: 'dev' as const, id: p.id, ...p.data })
);
const photos = (await getCollection('photos', ({ data }) => !data.draft)).map(
  (p) => ({ type: 'photo' as const, id: p.id, ...p.data })
);

const all = [...posts, ...photos].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

const byYear = all.reduce((acc, item) => {
  const year = item.date.getFullYear();
  (acc[year] ??= []).push(item);
  return acc;
}, {} as Record<number, typeof all>);

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="归档">
  <section>
    <div class="mb-12 flex items-center gap-2.5">
      <span class="h-2.5 w-2.5 rounded-sm bg-[var(--color-coral)]"></span>
      <h1 class="font-serif text-3xl font-semibold tracking-tight">归档</h1>
    </div>

    {
      years.map((year) => (
        <div class="mb-12">
          <h2 class="mb-4 flex items-center gap-2.5 font-serif text-xl font-medium text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
            <span class="h-2.5 w-2.5 rounded-sm bg-[var(--color-coral)]" />
            {year}
          </h2>
          <ul class="border-t border-[var(--color-line)] dark:border-[var(--color-line-dark)]">
            {byYear[year].map((item) => {
              const dateStr = item.date.toLocaleDateString('zh-CN', {
                month: '2-digit',
                day: '2-digit',
              });
              const href =
                item.type === 'dev' ? `/posts/${item.id}/` : `/photos/${item.id}/`;
              const typeColor =
                item.type === 'dev'
                  ? 'var(--color-sage)'
                  : 'var(--color-coral)';
              return (
                <li class="border-b border-[var(--color-line)] dark:border-[var(--color-line-dark)]">
                  <a
                    href={href}
                    class="group flex items-baseline gap-4 py-3"
                  >
                    <span class="text-xs text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)] tabular-nums w-12 shrink-0">
                      {dateStr}
                    </span>
                    <span
                      class="w-10 shrink-0 text-xs font-medium"
                      style={`color:${typeColor}`}
                    >
                      {item.type === 'dev' ? '开发' : '图文'}
                    </span>
                    <span class="font-serif text-base transition-colors group-hover:text-[var(--color-accent)]">
                      {item.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
