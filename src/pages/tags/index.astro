---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagColor } from '../../utils/tagColor';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const photos = await getCollection('photos', ({ data }) => !data.draft);
const all = [...posts, ...photos];

const tagMap = new Map<string, number>();
for (const item of all) {
  for (const tag of item.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN')
);
---

<BaseLayout title="标签">
  <section>
    <div class="mb-12 flex items-center gap-2.5">
      <span class="h-2.5 w-2.5 rounded-sm bg-[var(--color-coral)]"></span>
      <h1 class="font-serif text-3xl font-semibold tracking-tight">标签</h1>
    </div>

    {
      tags.length === 0 ? (
        <p class="text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
          还没有标签。
        </p>
      ) : (
        <div class="flex flex-wrap gap-2.5">
          {tags.map(([tag, count]) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="tag-pill px-3.5 py-1.5 text-sm"
              style={`--tag-text:${tagColor(tag)}`}
            >
              #{tag}
              <span class="ml-1.5 text-xs opacity-60">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
