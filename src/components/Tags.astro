---
interface Props {
  tags?: string[];
}
const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {tags.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="text-xs text-[var(--color-ink-mute)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
