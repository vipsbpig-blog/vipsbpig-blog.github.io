---
import { tagColor } from '../utils/tagColor';

interface Props {
  tags?: string[];
}
const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="tag-pill"
          style={`--tag-text:${tagColor(tag)}`}
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
