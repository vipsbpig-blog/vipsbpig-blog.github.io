---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="目录">
      <ul class="space-y-0.5 text-sm">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={[
                'toc-link block border-l-2 border-transparent py-1 pl-3 text-[var(--color-ink-mute)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] dark:text-[var(--color-ink-mute-dark)]',
                h.depth === 3 && 'ml-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
