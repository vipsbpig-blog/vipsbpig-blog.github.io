---
import Tags from './Tags.astro';

interface Props {
  type: 'dev' | 'photo';
  title: string;
  date: Date;
  summary?: string;
  tags?: string[];
  cover?: string;
  href: string;
  showSummary?: boolean;
}

const {
  type,
  title,
  date,
  summary,
  tags = [],
  cover,
  href,
  showSummary = true,
} = Astro.props;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const typeLabel = type === 'dev' ? '开发' : '图文';
---

<article class="group relative mb-8 break-inside-avoid">
  {
    cover && (
      <div class="mb-4 overflow-hidden rounded-lg shadow-[var(--shadow-soft)]">
        <img
          src={cover}
          alt={title}
          loading="lazy"
          class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )
  }

  <div class="mb-2 flex items-center gap-3 text-xs text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]">
    <span class="text-[var(--color-accent)]">{typeLabel}</span>
    <span class="opacity-40">·</span>
    <time datetime={date.toISOString()}>{dateStr}</time>
  </div>

  <h3 class="font-serif text-xl font-medium leading-snug tracking-tight text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)] dark:text-[var(--color-ink-dark)]">
    <a href={href} class="after:absolute after:inset-0 after:content-['']">{title}</a>
  </h3>

  {
    showSummary && summary && (
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-soft-dark)]">
        {summary}
      </p>
    )
  }

  {
    tags.length > 0 && (
      <div class="relative z-10 mt-3">
        <Tags tags={tags} />
      </div>
    )
  }
</article>
