---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--color-line)] bg-[var(--color-paper)]/80 backdrop-blur-md dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)]/80"
>
  <nav
    class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6"
  >
    <a
      href="/"
      class="font-serif text-lg font-medium tracking-tight text-[var(--color-ink)] transition-opacity hover:opacity-70 dark:text-[var(--color-ink-dark)]"
    >
      {SITE_TITLE}
    </a>

    <div class="flex items-center gap-6">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm transition-colors',
              isActive(link.href)
                ? 'text-[var(--color-accent)]'
                : 'text-[var(--color-ink-mute)] hover:text-[var(--color-ink)] dark:text-[var(--color-ink-mute-dark)] dark:hover:text-[var(--color-ink-dark)]',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
