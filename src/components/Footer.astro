---
import { AUTHOR, SOCIAL_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer
  class="border-t border-[var(--color-line)] py-8 dark:border-[var(--color-line-dark)]"
>
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-6 text-center text-sm text-[var(--color-ink-mute)] dark:text-[var(--color-ink-mute-dark)]"
  >
    <p>© {year} {AUTHOR}</p>
    <div class="flex items-center gap-4">
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener"
        class="transition-colors hover:text-[var(--color-accent)]"
      >
        GitHub
      </a>
      <span class="opacity-40">·</span>
      <a
        href={SOCIAL_LINKS.rss}
        class="transition-colors hover:text-[var(--color-accent)]"
      >
        RSS
      </a>
    </div>
  </div>
</footer>
